# Copy this file to server/.env and fill in your values, then restart the server.
# server/.env is gitignored — never commit real credentials.

# --- MySQL --------------------------------------------------------------------
# Create the DB + user first (once):  mysql -u root -p < server/sql/init.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wifi_dashboard
DB_USER=wifi
DB_PASSWORD=change-me

# --- Email (SMTP) -------------------------------------------------------------
# Host/port/user/from/to are set in the Settings UI; the PASSWORD lives here only
# so it's never written to settings.json. Example is a Gmail app password setup.
SMTP_PASS=

# --- Misc ---------------------------------------------------------------------
# PORT=4000
# PING_HOST=1.1.1.1
